<mxfile host="app.diagrams.net">
  <diagram id="comparison" name="Same operation, different workflow">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1280" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Installing jq and htop on one host" style="text;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Both routes use Ansible. The operator drives the workflow in both cases.&#10;Equivalent review controls shown. Direct Ansible can be enough for a single run." style="text;align=left;verticalAlign=middle;fontSize=18;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="1180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="left" value="" style="group;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="520" height="710" as="geometry"/>
        </mxCell>
        <mxCell id="right" value="" style="group;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="710" y="140" width="520" height="710" as="geometry"/>
        </mxCell>
        <mxCell id="left-header" value="Without CmdMesh&#10;You connect the workflow" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#334155;strokeColor=#334155;fontColor=#ffffff;" vertex="1" parent="left">
          <mxGeometry x="0" y="0" width="520" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="right-header" value="With CmdMesh&#10;CmdMesh connects the workflow" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;" vertex="1" parent="right">
          <mxGeometry x="0" y="0" width="520" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="left-inputs" value="Choose the inputs&#10;Playbook, collection, inventory, variables" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;" vertex="1" parent="left">
          <mxGeometry x="0" y="100" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="right-inputs" value="Choose a recipe and private target&#10;You still own the playbook and inputs" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;" vertex="1" parent="right">
          <mxGeometry x="0" y="100" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="left-check" value="Inspect and preview&#10;Your inventory tools + Ansible --check" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;" vertex="1" parent="left">
          <mxGeometry x="0" y="270" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="right-check" value="Inspect and preview&#10;CmdMesh inventory + an approved Ansible check" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#0f172a;" vertex="1" parent="right">
          <mxGeometry x="0" y="270" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="left-review" value="Save the reviewed file versions&#10;Recheck those versions before apply" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;" vertex="1" parent="left">
          <mxGeometry x="0" y="440" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="right-review" value="Create and review an apply plan&#10;CmdMesh stops if bound inputs changed" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#0f172a;" vertex="1" parent="right">
          <mxGeometry x="0" y="440" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="left-run" value="Coordinate execution and output&#10;Wire policy, local locking, status and logs&#10;Use scripts, CI or existing tooling" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;" vertex="1" parent="left">
          <mxGeometry x="0" y="610" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="right-run" value="Execute the approved plan through CLI&#10;CmdMesh checks policy and local target lock&#10;JSON result + optional private raw logs" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=19;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#0f172a;" vertex="1" parent="right">
          <mxGeometry x="0" y="610" width="520" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="Both: you verify the outcome&#10;Installed packages, host health and application checks" style="rounded=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="230" y="930" width="820" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="Equivalent workflow comparison. MCP offers inspection and planning; execution uses the CLI." style="text;align=left;verticalAlign=middle;fontSize=17;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="1050" width="1180" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="left-e1" edge="1" parent="1" source="left-inputs" target="left-check" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="left-e2" edge="1" parent="1" source="left-check" target="left-review" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="left-e3" edge="1" parent="1" source="left-review" target="left-run" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#64748b;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="right-e1" edge="1" parent="1" source="right-inputs" target="right-check" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2563eb;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="right-e2" edge="1" parent="1" source="right-check" target="right-review" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2563eb;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="right-e3" edge="1" parent="1" source="right-review" target="right-run" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2563eb;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="left-verify" edge="1" parent="1" source="left-run" target="verify" style="edgeStyle=orthogonalEdgeStyle;entryX=0.35;entryY=0;endArrow=block;strokeColor=#64748b;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="310" y="890"/><mxPoint x="517" y="890"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="right-verify" edge="1" parent="1" source="right-run" target="verify" style="edgeStyle=orthogonalEdgeStyle;entryX=0.65;entryY=0;endArrow=block;strokeColor=#2563eb;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="970" y="890"/><mxPoint x="763" y="890"/></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
